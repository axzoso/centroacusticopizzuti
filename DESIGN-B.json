  "narrative": {
    "northStar": "The Chain Storefront, in Pizzuti Blue",
    "overview": "B borrows the layout grammar of the big hearing-care chains (AudioNova first, Amplifon second): services first, large rounded photo cards that dissolve into a solid colour field, a slim contact bar, pill buttons with an arrow, a swipeable method carousel, full-width rounded bands. Only the language is borrowed. No third-party logos, copy, or photos appear anywhere; all copy comes from the shared `copy/*.ts`, and the colours are Pizzuti's.\n\nDensity is that of a contemporary commercial site: 16px body, 14px secondary text (accepted by the user for B, which drops A's older-reader legibility constraint while keeping readable contrast and phone-sized tap targets). Headings are soft and tight (600, negative tracking), never heavy. Depth comes from photos fading into the deep field plus light, diffuse shadows on things that sit on top of other things.",
    "keyCharacteristics": [
      "Photo-to-deep fades: hero, inner-page header, photo cards and photo band all dissolve a real or stock photo into solid `deep`.",
      "Very rounded geometry (24px) on cards, photos, boxes and bands; pills (999px) on every button and nav item.",
      "48px pill buttons; navigation buttons carry a trailing arrow that nudges 4px on hover.",
      "Red is an action colour only, never decoration.",
      "Card grids alternate with plain ruled row lists so pages do not become walls of cards."
    ],
    "rules": [
      {
        "name": "The Red Means Call Rule",
        "body": "Red fills only buttons and bands whose action is calling or booking by phone. If the action is navigation, WhatsApp, or reading more, it is an outline or white pill.",
        "section": "colors"
      },
      {
        "name": "The Glow Lives on Deep Rule",
        "body": "Sky glow is legible only on deep. On white, outlines and arrows switch to `mid` (`button-line-on-light`); glow appears on light only as a filled tile behind a deep icon.",
        "section": "colors"
      },
      {
        "name": "The 14px Floor Rule",
        "body": "Nothing smaller than 14px (`small`). Body stays 16px.",
        "section": "typography"
      },
      {
        "name": "The Fade Not Frame Rule",
        "body": "Photos on deep never get a border or hard edge; they dissolve into `deep` through a gradient (sideways on desktop, upward on mobile and in photo cards).",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** fade every photo on deep into the solid field; no hard photo edges on deep.",
      "**Do** keep red for call/book actions; WhatsApp and navigation are outline pills.",
      "**Do** use `glow` for outlines and arrows on deep and `mid` on light.",
      "**Do** alternate card grids with row lists, split sections and bands.",
      "**Do** use the client's real photos for the Doctor, the studio and products; stock (Unsplash, credited in `mockup/public/img/CREDITS.md`, stored in `mockup/public/img/b/`) only for lifestyle moments."
    ],
    "donts": [
      "**Don't** use any chain's logos, wording or photos; only the layout language is borrowed.",
      "**Don't** use generated images.",
      "**Don't** set text below 14px or headings above weight 600.",
      "**Don't** put shadows on resting flat cards; shadows mark overlap or lift.",
      "**Don't** reproduce proposal A's signature devices (portrait in an arch, heavy 700+ titles); ruled row lists are fine as an occasional alternative to cards, not as the page's main structure."
    ]
  }
