---
// Icone della Proposta B: stesso set di Icon.astro (tratto 2px, griglia 24) più alcune nuove.
import Icon from '../Icon.astro';
const { name, class: cls } = Astro.props;
const extra: Record<string, string> = {
  arrow: 'M4 12h15M13 6l6 6-6 6',
  calendar:'M5 5h14v15H5zM5 10h14M9 3v4M15 3v4',
  ear: 'M7 10a5 5 0 1 1 10 0c0 3-3 4-3 7a3 3 0 0 1-5.5 1.7M10 10a2 2 0 1 1 4 0c0 1.2-1 1.8-1.5 2.5',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
  'chevron-left': 'M15 5l-7 7 7 7',
  'chevron-right': 'M9 5l7 7-7 7',
  tool: 'M14.5 6.5a4 4 0 0 0 5 5L12 19a2.1 2.1 0 0 1-3-3l7.5-7.5zM14.5 6.5L17 4',
  volume: 'M4 9h4l5-4v14l-5-4H4zM17 9a4 4 0 0 1 0 6',
  power: 'M12 3v8M7 6.5a7 7 0 1 0 10 0',
  euro: 'M17 6.5A6.5 6.5 0 1 0 17 17.5M4 10h9M4 14h9',
  layers: 'M12 4l8 4-8 4-8-4 8-4zM4 12l8 4 8-4M4 16l8 4 8-4',
};
const d = extra[name];
---
{d
  ? <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={d} /></svg>
  : <span class:list={['b-ico', cls]} style="display:contents"><Icon name={name} /></span>}
