---
// Elenco a righe (titolo | testo) con filetto, in una o due colonne: alternativa alle griglie di card.
const { items = [], cols = 1, numbered = false } = Astro.props;
---
<dl class:list={['b-rows', { 'b-rows--2': cols === 2, 'is-num': numbered }]} data-stagger>
  {items.map((it, i) => (
    <div class="b-row">
      <dt>{numbered && <span class="b-row-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>}{it.titolo}</dt>
      <dd>{it.testo}</dd>
    </div>
  ))}
</dl>
