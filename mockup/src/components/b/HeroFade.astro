---
// Testata della home: foto a destra che sfuma nel campo profondo a sinistra (rif. screenshot 2).
const { titolo, lead, image, imageAlt, imagePos = '50% 50%' } = Astro.props;
---
<section class="b-hero b-deep-ctx">
  <figure class="b-hero-media">
    <img src={image} alt={imageAlt} style={`object-position:${imagePos}`} width="1600" height="1067" fetchpriority="high" />
  </figure>
  <div class="b-container b-hero-inner">
    <div class="b-hero-text">
      <h1 class="b-h1">{titolo}</h1>
      <p class="b-hero-lead">{lead}</p>
      <div class="b-btn-row"><slot /></div>
    </div>
  </div>
</section>
