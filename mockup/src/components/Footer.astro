---
import { SITE, FOOTER, LEGALI } from '../config';
import Icon from './Icon.astro';
---
<footer class="site-footer on-dark">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/logos/logo-white.png" alt={SITE.nome} width="1418" height="741" />
      <p>Centro acustico indipendente a {SITE.citta}. Ascolto su misura, dalla prima visita all’assistenza nel tempo.</p>
      <ul class="footer-social" aria-label="Social">
        {SITE.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener" aria-label={`${s.nome} (si apre in una nuova scheda)`}><Icon name={s.icona} /></a></li>)}
      </ul>
    </div>
    {FOOTER.map((col) => (
      <nav class="footer-col" aria-label={col.titolo}>
        <h2>{col.titolo}</h2>
        <ul>{col.voci.map((v) => <li><a href={v.href}>{v.label}</a></li>)}</ul>
      </nav>
    ))}
    <div class="footer-col footer-contact">
      <h2>Contatti</h2>
      <ul>
        <li><Icon name="pin" /><span>{SITE.indirizzo}</span></li>
        <li><Icon name="phone" /><a href={SITE.telefonoHref}>{SITE.telefonoVisibile}</a></li>
        <li><Icon name="whatsapp" /><a href={SITE.whatsappHref}>Scrivici su WhatsApp</a></li>
        <li><Icon name="mail" /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h2>Orari</h2>
      <dl class="footer-hours">
        {SITE.orari.map((o) => <div><dt>{o.giorni}</dt><dd>{o.ore}</dd></div>)}
      </dl>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© 2026 {SITE.societa} · {SITE.partitaIva}</p>
    <ul>
      {LEGALI.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href="#top" class="footer-top"><Icon name="up" />Torna su</a></li>
    </ul>
  </div>
</footer>
