---
import Page from '../layouts/Page.astro';
// Pagina legale: titolo, data di aggiornamento, avviso di bozza, sezioni numerate.
const { title, description, h1, aggiornato, sezioni = [], crumb } = Astro.props;
---
<Page title={title} description={description}>
  <section class="legal-hero">
    <div class="container">
      <h1>{h1}</h1>
      <p class="note">Ultimo aggiornamento: {aggiornato}</p>
      <p class="legal-draft" role="note"><strong>Bozza di esempio.</strong> Questo testo è un modello da far verificare da un consulente legale o dal DPO prima della pubblicazione. I dati del titolare sono segnaposto.</p>
    </div>
  </section>
  <section class="section legal-body">
    <div class="container two-col">
      <nav class="legal-toc" aria-label="Indice della pagina">
        <ol>{sezioni.map((s, i) => <li><a href={`#s${i + 1}`}>{s.titolo}</a></li>)}</ol>
      </nav>
      <div class="legal-text">
        {sezioni.map((s, i) => (
          <section id={`s${i + 1}`}>
            <h2>{s.titolo}</h2>
            {s.testo.map((t) => (Array.isArray(t) ? <ul>{t.map((li) => <li>{li}</li>)}</ul> : <p>{t}</p>))}
          </section>
        ))}
      </div>
    </div>
  </section>
</Page>
